        </LedWizEquivalentOutput>
        <LedWizEquivalentOutput>
          <OutputName>GamepadRumble\GamepadRumble.20</OutputName>
          <LedWizEquivalentOutputNumber>20</LedWizEquivalentOutputNumber>
        </LedWizEquivalentOutput>
        <LedWizEquivalentOutput>
          <OutputName>GamepadRumble\GamepadRumble.21</OutputName>
